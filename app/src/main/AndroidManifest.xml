<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <permission android:name="moe.nyaneko.kirisaki.REQUEST_STATE" android:protectionLevel="signature" />
    <uses-permission android:name="moe.nyaneko.kirisaki.REQUEST_STATE" />
    <queries><package android:name="com.oplus.location" /></queries>
    <application android:allowBackup="false" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name" android:dataExtractionRules="@xml/data_extraction_rules" android:supportsRtl="true" android:theme="@style/Theme.Kirisaki">
        <meta-data android:name="xposedmodule" android:value="true" />
        <meta-data android:name="xposeddescription" android:value="Cut the Override. ColorOS Google Location Accuracy guard." />
        <meta-data android:name="xposedminversion" android:value="82" />
        <meta-data android:name="xposedscope" android:resource="@array/xposed_scope" />
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity>
        <!-- State replies arrive through a UID-checked ephemeral Binder capability. -->
        <provider android:name=".StateProvider" android:authorities="moe.nyaneko.kirisaki.state"
            android:exported="false" android:grantUriPermissions="false" />
    </application>
</manifest>
